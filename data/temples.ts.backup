// States apne aap temples se ban jayenge, count bhi real hoga
export const states = Array.from(new Set(temples.map((t) => t.state))).map(
    (name) => ({
        name,
        slug: slugify(name),
        count: temples.filter((t) => t.state === name).length,
    })
);